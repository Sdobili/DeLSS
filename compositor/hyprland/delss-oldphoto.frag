#version 300 es
// DeLSS preset "oldphoto" (Old photo / 老照片) as one Hyprland screen shader.
// Generated by tools/compositor.py from shaders/. Do not edit by hand.
// Usage (hyprland.conf):  decoration:screen_shader = /path/to/this/file
// Colour only, no temporal pass; passes run at full effect (intensity 1).
precision highp float;
precision highp int;

in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;

// Host-provided values in the DeLSS contract, fixed for a screen shader.
vec2 uResolution;
const int uFrame = 0;
const bool uHasDepth = false;
const bool uHasNormal = false;
const bool uHasMotion = false;
const bool uHasHistory = false;
uniform sampler2D uDepth;   // never sampled: uHasDepth is false
uniform sampler2D uNormal;  // never sampled: uHasNormal is false

vec4 screen(vec2 uv) { return vec4(texture(tex, uv).rgb, 1.0); }
vec4 delssOutFull(vec3 styled) { return vec4(styled, 1.0); }
// DeLSS shared prelude. Inlined into every pass by tools/gen.py.
//
// Input contract (mirrors DLSS): every pass sees the original color frame and
// optional G-buffer channels. A pass that needs a channel checks its uHas*
// flag and falls back gracefully when the host did not provide it.

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

float luma(vec3 c) { return dot(c, LUMA); }

vec2 texel() { return 1.0 / uResolution; }

// Classic 8x8 Bayer threshold in [0,1). Anchored to integer screen cells, so it
// never crawls when the camera is still and never shimmers between frames.
float bayer8(ivec2 p) {
  p &= 7;
  int x = p.x;
  int y = p.y ^ p.x;
  int v = ((y & 1) << 5) | ((x & 1) << 4) | ((y & 2) << 2) | ((x & 2) << 1) | ((y & 4) >> 1) |
          ((x & 4) >> 2);
  return (float(v) + 0.5) / 64.0;
}

// The PlayStation GPU's 4x4 dither table, in 8-bit color steps.
float ps1Dither(ivec2 p) {
  const float m[16] = float[16](-4.0, 0.0, -3.0, 1.0, 2.0, -2.0, 3.0, -1.0, -3.0, 1.0, -4.0, 0.0,
                                3.0, -1.0, 2.0, -2.0);
  p &= 3;
  return m[p.y * 4 + p.x];
}

// Integer hash (no sin()): bit-exact across GPUs, which keeps goldens stable.
float hash12(uvec2 p) {
  uvec3 v = uvec3(p, 0x9E37u) * uvec3(1597334673u, 3812015801u, 2798796415u);
  uint n = (v.x ^ v.y ^ v.z) * 1597334673u;
  return float(n >> 8) / 16777216.0;
}

vec3 srgbToLinear(vec3 c) { return pow(max(c, 0.0), vec3(2.2)); }
vec3 linearToSrgb(vec3 c) { return pow(max(c, 0.0), vec3(1.0 / 2.2)); }

// OKLab: perceptual color space; nearest-palette search in it looks much better
// than plain RGB distance (no muddy greens for skin tones).
vec3 toOklab(vec3 srgb) {
  vec3 c = srgbToLinear(srgb);
  vec3 lms = mat3(0.4122214708, 0.2119034982, 0.0883024619, 0.5363325363, 0.6806995451,
                  0.2817188376, 0.0514459929, 0.1073969566, 0.6299787005) *
             c;
  lms = pow(max(lms, 0.0), vec3(1.0 / 3.0));
  return mat3(0.2104542553, 1.9779984951, 0.0259040371, 0.7936177850, -2.4285922050,
              0.7827717662, -0.0040720468, 0.4505937099, -0.8086757660) *
         lms;
}

// Final blend shared by every pass: the intensity slider is a straight mix
// against the pass input, so 0 is an exact bypass.

// ---- pass 0: kuwahara
const float u0_radius = 1.0;
// kuwahara: edge-preserving smoothing that turns photo texture into flat
// painted regions. For each pixel, look at four overlapping quadrants and keep
// the mean of the one with the lowest variance: flat areas get averaged, while
// an edge is never blurred because some quadrant always lies on one side of it.

vec4 pass0(vec2 delss_uv) {
  vec4 delss_fc = vec4(delss_uv * uResolution, 0.0, 1.0);
  int r = int(clamp(floor(u0_radius + 0.5), 1.0, 6.0));
  vec2 t = texel();
  vec3 mean[4];
  vec3 sq[4];
  for (int k = 0; k < 4; ++k) {
    mean[k] = vec3(0.0);
    sq[k] = vec3(0.0);
  }
  for (int j = -6; j <= 6; ++j) {
    for (int i = -6; i <= 6; ++i) {
      if (abs(i) > r || abs(j) > r) continue;
      vec3 c = screen(delss_uv + vec2(i, j) * t).rgb;
      vec3 c2 = c * c;
      // A tap on an axis belongs to both neighboring quadrants.
      if (i <= 0 && j <= 0) { mean[0] += c; sq[0] += c2; }
      if (i >= 0 && j <= 0) { mean[1] += c; sq[1] += c2; }
      if (i <= 0 && j >= 0) { mean[2] += c; sq[2] += c2; }
      if (i >= 0 && j >= 0) { mean[3] += c; sq[3] += c2; }
    }
  }
  float n = float((r + 1) * (r + 1));
  float best = 1e9;
  vec3 result = screen(delss_uv).rgb;
  for (int k = 0; k < 4; ++k) {
    vec3 m = mean[k] / n;
    vec3 v = abs(sq[k] / n - m * m);
    float s = v.r + v.g + v.b;
    if (s < best) {
      best = s;
      result = m;
    }
  }
  return delssOutFull(result);
}

// ---- pass 1: grade
const float u1_sepia = 0.85;
const float u1_saturation = 0.4;
const float u1_contrast = 1.1;
const float u1_fade = 0.1;
const float u1_vignette = 0.7;
const float u1_grain = 0.06;
const float u1_grainSpeed = 0.0;
// grade: "old photograph" color grading. Sepia toning, faded blacks, contrast,
// vignette and film grain. Grain is anchored to the screen and only re-rolled
// when u1_grainSpeed > 0, so the default look is static.

vec4 pass1(vec2 delss_uv) {
  vec4 delss_fc = vec4(delss_uv * uResolution, 0.0, 1.0);
  vec3 c = pass0(delss_uv).rgb;
  float l = luma(c);
  c = mix(vec3(l), c, u1_saturation);
  vec3 sep = vec3(dot(c, vec3(0.393, 0.769, 0.189)), dot(c, vec3(0.349, 0.686, 0.168)),
                  dot(c, vec3(0.272, 0.534, 0.131)));
  c = mix(c, sep, u1_sepia);
  c = (c - 0.5) * u1_contrast + 0.5;
  c = mix(vec3(u1_fade), vec3(1.0 - u1_fade * 0.3), c);
  vec2 v = delss_uv * (1.0 - delss_uv);
  c *= mix(1.0, pow(16.0 * v.x * v.y, 0.35), u1_vignette);
  uint epoch = u1_grainSpeed > 0.0 ? uint(float(uFrame) * u1_grainSpeed) : 0u;
  float g = hash12(uvec2(delss_fc.xy) + uvec2(epoch * 131u, epoch * 71u)) - 0.5;
  c += g * u1_grain;
  return delssOutFull(clamp(c, 0.0, 1.0));
}

void main() {
  uResolution = vec2(textureSize(tex, 0));
  fragColor = pass1(v_texcoord);
}
