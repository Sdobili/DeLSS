#version 300 es
// DeLSS preset "gameboy" (Game Boy) as one Hyprland screen shader.
// Generated by tools/compositor.py from shaders/. Do not edit by hand.
// Usage (hyprland.conf):  decoration:screen_shader = /path/to/this/file
// Colour only, no temporal pass; passes run at full effect (intensity 1).
precision highp float;
precision highp int;

in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;

// Host-provided values in the DeLSS contract, fixed for a screen shader.
vec2 uResolution;
const int uFrame = 0;
const bool uHasDepth = false;
const bool uHasNormal = false;
const bool uHasMotion = false;
const bool uHasHistory = false;
uniform sampler2D uDepth;   // never sampled: uHasDepth is false
uniform sampler2D uNormal;  // never sampled: uHasNormal is false

vec4 screen(vec2 uv) { return vec4(texture(tex, uv).rgb, 1.0); }
vec4 delssOutFull(vec3 styled) { return vec4(styled, 1.0); }
// DeLSS shared prelude. Inlined into every pass by tools/gen.py.
//
// Input contract (mirrors DLSS): every pass sees the original color frame and
// optional G-buffer channels. A pass that needs a channel checks its uHas*
// flag and falls back gracefully when the host did not provide it.

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

float luma(vec3 c) { return dot(c, LUMA); }

vec2 texel() { return 1.0 / uResolution; }

// Classic 8x8 Bayer threshold in [0,1). Anchored to integer screen cells, so it
// never crawls when the camera is still and never shimmers between frames.
float bayer8(ivec2 p) {
  p &= 7;
  int x = p.x;
  int y = p.y ^ p.x;
  int v = ((y & 1) << 5) | ((x & 1) << 4) | ((y & 2) << 2) | ((x & 2) << 1) | ((y & 4) >> 1) |
          ((x & 4) >> 2);
  return (float(v) + 0.5) / 64.0;
}

// The PlayStation GPU's 4x4 dither table, in 8-bit color steps.
float ps1Dither(ivec2 p) {
  const float m[16] = float[16](-4.0, 0.0, -3.0, 1.0, 2.0, -2.0, 3.0, -1.0, -3.0, 1.0, -4.0, 0.0,
                                3.0, -1.0, 2.0, -2.0);
  p &= 3;
  return m[p.y * 4 + p.x];
}

// Integer hash (no sin()): bit-exact across GPUs, which keeps goldens stable.
float hash12(uvec2 p) {
  uvec3 v = uvec3(p, 0x9E37u) * uvec3(1597334673u, 3812015801u, 2798796415u);
  uint n = (v.x ^ v.y ^ v.z) * 1597334673u;
  return float(n >> 8) / 16777216.0;
}

vec3 srgbToLinear(vec3 c) { return pow(max(c, 0.0), vec3(2.2)); }
vec3 linearToSrgb(vec3 c) { return pow(max(c, 0.0), vec3(1.0 / 2.2)); }

// OKLab: perceptual color space; nearest-palette search in it looks much better
// than plain RGB distance (no muddy greens for skin tones).
vec3 toOklab(vec3 srgb) {
  vec3 c = srgbToLinear(srgb);
  vec3 lms = mat3(0.4122214708, 0.2119034982, 0.0883024619, 0.5363325363, 0.6806995451,
                  0.2817188376, 0.0514459929, 0.1073969566, 0.6299787005) *
             c;
  lms = pow(max(lms, 0.0), vec3(1.0 / 3.0));
  return mat3(0.2104542553, 1.9779984951, 0.0259040371, 0.7936177850, -2.4285922050,
              0.7827717662, -0.0040720468, 0.4505937099, -0.8086757660) *
         lms;
}

// Final blend shared by every pass: the intensity slider is a straight mix
// against the pass input, so 0 is an exact bypass.

// ---- pass 0: pixelate
const float u0_pixelSize = 4.0;
// pixelate: snap the frame to a coarse grid of square "fat pixels".
//
// Each cell is the box-filtered average of the pixels it covers, not a point
// sample. Point sampling picks one arbitrary texel per cell, so thin detail
// pops in and out as the camera moves; averaging makes the cell color a smooth
// function of the scene, which is what keeps pixel art from flickering.

vec4 pass0(vec2 delss_uv) {
  vec4 delss_fc = vec4(delss_uv * uResolution, 0.0, 1.0);
  float size = max(1.0, floor(u0_pixelSize + 0.5));
  vec2 cell = floor(delss_fc.xy / size);
  vec2 origin = cell * size;
  // 4x4 stratified taps per cell, clamped so huge cells stay cheap.
  vec3 sum = vec3(0.0);
  for (int j = 0; j < 4; ++j) {
    for (int i = 0; i < 4; ++i) {
      vec2 p = origin + (vec2(i, j) + 0.5) * (size / 4.0);
      sum += screen(p / uResolution).rgb;
    }
  }
  return delssOutFull(sum / 16.0);
}

// ---- pass 1: palette
const vec3 u1_palette[16] = vec3[16](vec3(0.058824, 0.219608, 0.058824), vec3(0.188235, 0.384314, 0.188235), vec3(0.545098, 0.67451, 0.058824), vec3(0.607843, 0.737255, 0.058824), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0));
const int u1_paletteSize = 4;
const float u1_levels = 32.0;
const float u1_dither = 0.7;
const float u1_ditherScale = 4.0;
const int u1_ditherMatrix = 0;
const int u1_mapping = 1;
const float u1_exposure = 1.0;
// palette: quantize to a fixed palette (or to N levels per channel) with
// ordered dithering.
//
// Ordered dithering is the temporally stable choice: the threshold depends only
// on the integer screen cell, so a static image produces a static pattern.
// Error diffusion (Floyd-Steinberg) would ripple across the whole frame
// whenever a single pixel changes.

vec3 nearestPalette(vec3 c) {
  vec3 lab = toOklab(c);
  float best = 1e9;
  vec3 result = u1_palette[0];
  for (int i = 0; i < 16; ++i) {
    if (i >= u1_paletteSize) break;
    vec3 d = toOklab(u1_palette[i]) - lab;
    float dist = dot(d, d);
    if (dist < best) {
      best = dist;
      result = u1_palette[i];
    }
  }
  return result;
}

// Luminance ramp: sort the palette by brightness and index it by the pixel's
// brightness. This is how monochrome hardware (Game Boy, CGA) is usually
// emulated: a 4-shade green screen should show light and shadow, not try to
// find the "closest green" to a blue sky.
vec3 rampPalette(float l) {
  vec3 sorted[16];
  int n = 0;
  for (int i = 0; i < 16; ++i) {
    if (i >= u1_paletteSize) break;
    vec3 c = u1_palette[i];
    int j = n;
    while (j > 0 && luma(sorted[j - 1]) > luma(c)) {
      sorted[j] = sorted[j - 1];
      --j;
    }
    sorted[j] = c;
    ++n;
  }
  int idx = clamp(int(floor(l * float(n))), 0, n - 1);
  return sorted[idx];
}

vec4 pass1(vec2 delss_uv) {
  vec4 delss_fc = vec4(delss_uv * uResolution, 0.0, 1.0);
  vec3 c = clamp(pass0(delss_uv).rgb * u1_exposure, 0.0, 1.0);
  ivec2 cell = ivec2(floor(delss_fc.xy / max(1.0, floor(u1_ditherScale + 0.5))));
  vec3 q;
  if (u1_paletteSize > 0) {
    // Spread ~ one palette step; a palette of n colors spans ~1/(n^(1/3)) per axis.
    float spread = u1_dither / pow(float(u1_paletteSize), 1.0 / 3.0);
    float t = bayer8(cell) - 0.5;
    if (u1_mapping == 1) {
      float n = float(u1_paletteSize);
      q = rampPalette(clamp(luma(c) + t * u1_dither / n, 0.0, 1.0));
    } else {
      q = nearestPalette(clamp(c + vec3(t * spread), 0.0, 1.0));
    }
  } else {
    float levels = max(2.0, u1_levels);
    float step = 1.0 / (levels - 1.0);
    float t = u1_ditherMatrix == 1 ? ps1Dither(cell) / 8.0 : bayer8(cell) - 0.5;
    q = floor((c + t * step * u1_dither) / step + 0.5) * step;
  }
  return delssOutFull(clamp(q, 0.0, 1.0));
}

void main() {
  uResolution = vec2(textureSize(tex, 0));
  fragColor = pass1(v_texcoord);
}
