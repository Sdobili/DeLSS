#version 300 es
// DeLSS preset "comic" (Comic ink / 美漫) as one Hyprland screen shader.
// Generated by tools/compositor.py from shaders/. Do not edit by hand.
// Usage (hyprland.conf):  decoration:screen_shader = /path/to/this/file
// Colour only, no temporal pass; passes run at full effect (intensity 1).
precision highp float;
precision highp int;

in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;

// Host-provided values in the DeLSS contract, fixed for a screen shader.
vec2 uResolution;
const int uFrame = 0;
const bool uHasDepth = false;
const bool uHasNormal = false;
const bool uHasMotion = false;
const bool uHasHistory = false;
uniform sampler2D uDepth;   // never sampled: uHasDepth is false
uniform sampler2D uNormal;  // never sampled: uHasNormal is false

vec4 screen(vec2 uv) { return vec4(texture(tex, uv).rgb, 1.0); }
vec4 delssOutFull(vec3 styled) { return vec4(styled, 1.0); }
// DeLSS shared prelude. Inlined into every pass by tools/gen.py.
//
// Input contract (mirrors DLSS): every pass sees the original color frame and
// optional G-buffer channels. A pass that needs a channel checks its uHas*
// flag and falls back gracefully when the host did not provide it.

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

float luma(vec3 c) { return dot(c, LUMA); }

vec2 texel() { return 1.0 / uResolution; }

// Classic 8x8 Bayer threshold in [0,1). Anchored to integer screen cells, so it
// never crawls when the camera is still and never shimmers between frames.
float bayer8(ivec2 p) {
  p &= 7;
  int x = p.x;
  int y = p.y ^ p.x;
  int v = ((y & 1) << 5) | ((x & 1) << 4) | ((y & 2) << 2) | ((x & 2) << 1) | ((y & 4) >> 1) |
          ((x & 4) >> 2);
  return (float(v) + 0.5) / 64.0;
}

// The PlayStation GPU's 4x4 dither table, in 8-bit color steps.
float ps1Dither(ivec2 p) {
  const float m[16] = float[16](-4.0, 0.0, -3.0, 1.0, 2.0, -2.0, 3.0, -1.0, -3.0, 1.0, -4.0, 0.0,
                                3.0, -1.0, 2.0, -2.0);
  p &= 3;
  return m[p.y * 4 + p.x];
}

// Integer hash (no sin()): bit-exact across GPUs, which keeps goldens stable.
float hash12(uvec2 p) {
  uvec3 v = uvec3(p, 0x9E37u) * uvec3(1597334673u, 3812015801u, 2798796415u);
  uint n = (v.x ^ v.y ^ v.z) * 1597334673u;
  return float(n >> 8) / 16777216.0;
}

vec3 srgbToLinear(vec3 c) { return pow(max(c, 0.0), vec3(2.2)); }
vec3 linearToSrgb(vec3 c) { return pow(max(c, 0.0), vec3(1.0 / 2.2)); }

// OKLab: perceptual color space; nearest-palette search in it looks much better
// than plain RGB distance (no muddy greens for skin tones).
vec3 toOklab(vec3 srgb) {
  vec3 c = srgbToLinear(srgb);
  vec3 lms = mat3(0.4122214708, 0.2119034982, 0.0883024619, 0.5363325363, 0.6806995451,
                  0.2817188376, 0.0514459929, 0.1073969566, 0.6299787005) *
             c;
  lms = pow(max(lms, 0.0), vec3(1.0 / 3.0));
  return mat3(0.2104542553, 1.9779984951, 0.0259040371, 0.7936177850, -2.4285922050,
              0.7827717662, -0.0040720468, 0.4505937099, -0.8086757660) *
         lms;
}

// Final blend shared by every pass: the intensity slider is a straight mix
// against the pass input, so 0 is an exact bypass.

// ---- pass 0: kuwahara
const float u0_radius = 3.0;
// kuwahara: edge-preserving smoothing that turns photo texture into flat
// painted regions. For each pixel, look at four overlapping quadrants and keep
// the mean of the one with the lowest variance: flat areas get averaged, while
// an edge is never blurred because some quadrant always lies on one side of it.

vec4 pass0(vec2 delss_uv) {
  vec4 delss_fc = vec4(delss_uv * uResolution, 0.0, 1.0);
  int r = int(clamp(floor(u0_radius + 0.5), 1.0, 6.0));
  vec2 t = texel();
  vec3 mean[4];
  vec3 sq[4];
  for (int k = 0; k < 4; ++k) {
    mean[k] = vec3(0.0);
    sq[k] = vec3(0.0);
  }
  for (int j = -6; j <= 6; ++j) {
    for (int i = -6; i <= 6; ++i) {
      if (abs(i) > r || abs(j) > r) continue;
      vec3 c = screen(delss_uv + vec2(i, j) * t).rgb;
      vec3 c2 = c * c;
      // A tap on an axis belongs to both neighboring quadrants.
      if (i <= 0 && j <= 0) { mean[0] += c; sq[0] += c2; }
      if (i >= 0 && j <= 0) { mean[1] += c; sq[1] += c2; }
      if (i <= 0 && j >= 0) { mean[2] += c; sq[2] += c2; }
      if (i >= 0 && j >= 0) { mean[3] += c; sq[3] += c2; }
    }
  }
  float n = float((r + 1) * (r + 1));
  float best = 1e9;
  vec3 result = screen(delss_uv).rgb;
  for (int k = 0; k < 4; ++k) {
    vec3 m = mean[k] / n;
    vec3 v = abs(sq[k] / n - m * m);
    float s = v.r + v.g + v.b;
    if (s < best) {
      best = s;
      result = m;
    }
  }
  return delssOutFull(result);
}

// ---- pass 1: cel
const float u1_bands = 3.0;
const float u1_softness = 0.15;
const float u1_saturation = 1.4;
const float u1_brightness = 1.35;
// cel: toon shading as a post process. Quantize brightness into a few bands but
// keep each pixel's chroma, so a red jacket stays red in every band. A small
// smoothstep at each band boundary removes stair-step aliasing; hysteresis
// against the previous frame (see the temporal pass) handles the rest.

vec4 pass1(vec2 delss_uv) {
  vec4 delss_fc = vec4(delss_uv * uResolution, 0.0, 1.0);
  vec3 c = pass0(delss_uv).rgb;
  float l = luma(c);
  float bands = max(2.0, u1_bands);
  float x = l * bands;
  float f = fract(x);
  float w = max(u1_softness, 1e-3) * 0.5;
  float q = (floor(x) + smoothstep(0.5 - w, 0.5 + w, f)) / bands;
  q = clamp(q + 0.5 / bands, 0.0, 1.0);
  vec3 chroma = c / max(l, 1e-3);
  vec3 styled = chroma * q * u1_brightness;
  styled = mix(vec3(luma(styled)), styled, u1_saturation);
  return delssOutFull(clamp(styled, 0.0, 1.0));
}

// ---- pass 2: halftone
const float u2_dotSize = 5.0;
const float u2_angle = 45.0;
const vec3 u2_paperColor = vec3(0.968627, 0.941176, 0.862745);
const vec3 u2_dotColor = vec3(0.078431, 0.062745, 0.101961);
const float u2_shadowOnly = 1.0;
// halftone: comic-book print dots. A rotated screen-space grid of round dots
// whose radius follows darkness. The grid is anchored to the screen, like a
// printing screen over a page, so dots never swim.

vec4 pass2(vec2 delss_uv) {
  vec4 delss_fc = vec4(delss_uv * uResolution, 0.0, 1.0);
  vec3 c = pass1(delss_uv).rgb;
  float a = radians(u2_angle);
  mat2 rot = mat2(cos(a), -sin(a), sin(a), cos(a));
  float period = max(2.0, u2_dotSize);
  vec2 p = rot * delss_fc.xy / period;
  vec2 cellCenter = floor(p) + 0.5;
  float dist = length(p - cellCenter);
  float darkness = 1.0 - luma(c);
  // Area coverage = darkness -> radius = sqrt(darkness / pi) in cell units.
  float radius = sqrt(darkness / 3.14159265) * 1.1;
  float aa = 0.75 / period;  // ~one pixel of antialiasing
  float dot_ = 1.0 - smoothstep(radius - aa, radius + aa, dist);
  vec3 styled;
  if (u2_shadowOnly > 0.5) {
    float shadow = smoothstep(0.45, 0.25, luma(c));
    styled = mix(c, mix(c, u2_dotColor, 0.85), dot_ * shadow);
  } else {
    styled = mix(u2_paperColor, u2_dotColor, dot_);
  }
  return delssOutFull(styled);
}

// ---- pass 3: ink
const float u3_width = 2.5;
const float u3_threshold = 0.45;
const vec3 u3_inkColor = vec3(0.078431, 0.062745, 0.101961);
const float u3_depthWeight = 1.0;
const float u3_normalWeight = 1.0;
// ink: outlines for cel and comic looks.
//
// Edges come from geometry whenever the engine provides it: depth
// discontinuities give silhouettes, normal discontinuities give creases. Both
// are stable from frame to frame because they do not depend on lighting or
// texture. Without a G-buffer we fall back to a Sobel on the luminance of this
// pass's input; put kuwahara/cel first so it traces regions, not photo grain.

float lumaSobel(vec2 uv, vec2 d) {
  float s[9];
  int k = 0;
  for (int j = -1; j <= 1; ++j) {
    for (int i = -1; i <= 1; ++i) {
      s[k++] = luma(pass2(uv + vec2(i, j) * d).rgb);
    }
  }
  float gx = s[2] + 2.0 * s[5] + s[8] - s[0] - 2.0 * s[3] - s[6];
  float gy = s[6] + 2.0 * s[7] + s[8] - s[0] - 2.0 * s[1] - s[2];
  return length(vec2(gx, gy)) * 2.0;
}

// Relative depth jump to the 4 neighbors. Dividing by depth makes the test
// scale-free: a floor receding to the horizon changes depth smoothly (small
// relative steps, even after 8-bit quantization) while a silhouette jumps.
float depthEdge(vec2 uv, vec2 d) {
  float c = texture(uDepth, uv).r;
  float e = 0.0;
  for (int k = 0; k < 4; ++k) {
    vec2 o = k == 0 ? vec2(d.x, 0.0) : k == 1 ? vec2(-d.x, 0.0) : k == 2 ? vec2(0.0, d.y) : vec2(0.0, -d.y);
    float n = texture(uDepth, uv + o).r;
    e = max(e, abs(n - c) / max(min(n, c), 0.02));
  }
  return e * 4.0;
}

float normalEdge(vec2 uv, vec2 d) {
  vec3 n = texture(uNormal, uv).rgb * 2.0 - 1.0;
  float e = 0.0;
  e = max(e, 1.0 - dot(n, texture(uNormal, uv + vec2(d.x, 0.0)).rgb * 2.0 - 1.0));
  e = max(e, 1.0 - dot(n, texture(uNormal, uv - vec2(d.x, 0.0)).rgb * 2.0 - 1.0));
  e = max(e, 1.0 - dot(n, texture(uNormal, uv + vec2(0.0, d.y)).rgb * 2.0 - 1.0));
  e = max(e, 1.0 - dot(n, texture(uNormal, uv - vec2(0.0, d.y)).rgb * 2.0 - 1.0));
  return e * 4.0;
}

vec4 pass3(vec2 delss_uv) {
  vec4 delss_fc = vec4(delss_uv * uResolution, 0.0, 1.0);
  vec2 d = texel() * max(0.5, u3_width * 0.5);
  float edge;
  if (uHasDepth || uHasNormal) {
    edge = 0.0;
    if (uHasDepth) edge = max(edge, depthEdge(delss_uv, d) * u3_depthWeight);
    if (uHasNormal) edge = max(edge, normalEdge(delss_uv, d) * u3_normalWeight);
  } else {
    edge = lumaSobel(delss_uv, d);
  }
  float t = max(u3_threshold, 1e-3);
  float line = smoothstep(t, t * 1.6, edge);
  vec3 base = pass2(delss_uv).rgb;
  return delssOutFull(mix(base, u3_inkColor, line));
}

void main() {
  uResolution = vec2(textureSize(tex, 0));
  fragColor = pass3(v_texcoord);
}
