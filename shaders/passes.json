{
  "pixelate": {
    "label": "Pixelate",
    "params": {
      "pixelSize": {
        "type": "float",
        "default": 4,
        "min": 1,
        "max": 32,
        "step": 1,
        "label": "Pixel size"
      }
    }
  },
  "palette": {
    "label": "Palette / dither",
    "params": {
      "palette": {
        "type": "palette",
        "default": "pico8",
        "label": "Palette (none = levels)"
      },
      "levels": {
        "type": "float",
        "default": 32,
        "min": 2,
        "max": 64,
        "step": 1,
        "label": "Levels per channel"
      },
      "dither": {
        "type": "float",
        "default": 0.6,
        "min": 0,
        "max": 1,
        "step": 0.01,
        "label": "Dither"
      },
      "ditherScale": {
        "type": "float",
        "default": 4,
        "min": 1,
        "max": 32,
        "step": 1,
        "label": "Dither cell"
      },
      "ditherMatrix": {
        "type": "int",
        "default": 0,
        "min": 0,
        "max": 1,
        "step": 1,
        "label": "Matrix (0 Bayer, 1 PS1)"
      },
      "mapping": {
        "type": "int",
        "default": 0,
        "min": 0,
        "max": 1,
        "step": 1,
        "label": "Mapping (0 nearest, 1 luma ramp)"
      },
      "exposure": {
        "type": "float",
        "default": 1,
        "min": 0.5,
        "max": 2,
        "step": 0.01,
        "label": "Exposure"
      }
    }
  },
  "kuwahara": {
    "label": "Kuwahara paint",
    "params": {
      "radius": {
        "type": "float",
        "default": 3,
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Radius"
      }
    }
  },
  "cel": {
    "label": "Cel bands",
    "params": {
      "bands": {
        "type": "float",
        "default": 4,
        "min": 2,
        "max": 8,
        "step": 1,
        "label": "Bands"
      },
      "softness": {
        "type": "float",
        "default": 0.15,
        "min": 0,
        "max": 1,
        "step": 0.01,
        "label": "Softness"
      },
      "saturation": {
        "type": "float",
        "default": 1.25,
        "min": 0,
        "max": 2,
        "step": 0.01,
        "label": "Saturation"
      },
      "brightness": {
        "type": "float",
        "default": 1.15,
        "min": 0.5,
        "max": 2,
        "step": 0.01,
        "label": "Brightness"
      }
